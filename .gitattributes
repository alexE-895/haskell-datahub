# Repository text files use LF in Git.
* text=auto

*.hs        text eol=lf
*.cabal     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.nix       text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf

# Windows scripts remain CRLF-friendly.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf